{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "cli/**/*.ts"],
  "exclude": ["**/node_modules", "**/dist", "packages/web/**", "legacy/**"]
}
