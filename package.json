{
  "name": "companybrain",
  "version": "2.0.0",
  "private": true,
  "description": "Company Brain — task management for humans and AI agents. Nothing slips.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.28.0",
  "workspaces": [
    "packages/*",
    "cli"
  ],
  "scripts": {
    "dev": "tsx cli/bin/companybrain.ts",
    "dev:web": "pnpm --filter @companybrain/web dev",
    "start": "node server.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web",
    "test": "node --import tsx --test \"packages/*/test/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "mcp": "tsx cli/bin/companybrain.ts mcp"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@playwright/test": "1.56.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
