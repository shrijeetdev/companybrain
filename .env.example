# companybrain — one self-contained app. Copy to .env and fill what you need.
# Data lives in a single SQLite file (~/.companybrain/companybrain.sqlite). No DB/Redis to run.

# Port + host the app listens on. Default host 0.0.0.0 so it works on a server out of the box.
COMPANYBRAIN_PORT=4317
COMPANYBRAIN_HOST=0.0.0.0

# Optional: override where the SQLite file lives (e.g. a mounted volume on the server).
# COMPANYBRAIN_DB_PATH=/data/companybrain.sqlite

# --- Security ---
# CORS allowed origins (comma-separated). Leave empty to allow all origins (dev mode).
# COMPANYBRAIN_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting
COMPANYBRAIN_LOG_LEVEL=info

# Secure cookie (set to true in production with HTTPS)
# COMPANYBRAIN_SECURE_COOKIE=true

# --- integrations (server-side only; never shipped to the client) ---

# WhatsApp Cloud API (official Meta Business API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# WhatsApp Baileys (free QR-pairing mode — set to "on" to enable)
# WHATSAPP_BAILEYS=on

# Gmail OAuth (Google Cloud Console → OAuth 2.0 Client ID)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Slack integration
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# GitHub integration
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- LLM (server-side only) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- MCP stdio server — `companybrain mcp`. Set to an API key created for an `agent`
# account in the web app (Settings → User Management). The MCP host (Claude Desktop,
# Cursor) spawns `companybrain mcp` with this in its env. Leave unset to disable MCP.
COMPANYBRAIN_MCP_KEY=

# --- AI executor (sub-project B) ---
# OpenRouter API key (https://openrouter.ai). Required for AI task execution. Server-side
# only — without it the runAiTask worker skips and AI tasks stay queued.
OPENROUTER_API_KEY=

# Optional per-action model overrides (OpenRouter slugs). Default: anthropic/claude-3.5-sonnet.
# COMPANYBRAIN_AI_MODEL_GENERATE=anthropic/claude-3.5-sonnet
# COMPANYBRAIN_AI_MODEL_PUBLISH_BLOG=anthropic/claude-3.5-sonnet

# WordPress (for the publish_blog action) is configured in the app, not here:
# PUT /api/connections/wordpress with { apiUrl, username, appPassword }. The application
# password is stored encrypted in the connections table and is never logged or returned.

# --- Metrics ---
# /metrics is served only to a caller holding this token when NODE_ENV=production.
# Leave unset in production and the endpoint is off (404).
# COMPANYBRAIN_METRICS_TOKEN=

# --- Backups ---
# The nightly backup runs inside the app. Set to `off` when your host snapshots the volume.
# COMPANYBRAIN_BACKUP=off
# COMPANYBRAIN_BACKUP_DIR=~/.companybrain/backups
# COMPANYBRAIN_BACKUP_RETENTION=14

# --- Supabase (optional, for production database + auth) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Error tracking (optional) ---
# SENTRY_DSN=https://your-sentry-dsn
