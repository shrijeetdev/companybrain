# companybrain — copy to `.env` (loaded automatically) or set these in your host's panel.
# EVERYTHING here is optional: with nothing set, companybrain runs with in-app notifications,
# Web Push and the built-in natural-language parser. Blank values are treated as unset.
# There are no passwords here on purpose — the first visit to the app runs a setup wizard
# that creates your company and owner account.

# ─── Server ──────────────────────────────────────────────────────────────────
# Public HTTPS address of this app. REQUIRED for "paste the URL into Claude/ChatGPT" (OAuth MCP),
# push notifications on iOS, and correct links in reminders.
COMPANYBRAIN_PUBLIC_URL=
COMPANYBRAIN_PORT=4317
COMPANYBRAIN_HOST=0.0.0.0
# SQLite file. Everything else the app generates (secret.key, signing.key, vapid.json,
# whatsapp-auth/) is stored next to it — back up this whole directory.
# COMPANYBRAIN_DB_PATH=/data/companybrain.sqlite
# Behind a reverse proxy (nginx, Hostinger, Cloudflare): true (= exactly ONE trusted hop), the
# number of proxy hops, or a comma-separated list of trusted proxy IPs/CIDRs.
COMPANYBRAIN_TRUST_PROXY=false
# auto = Secure cookie when the request is HTTPS (recommended). true/false to force.
COMPANYBRAIN_SECURE_COOKIE=auto
# Extra origins allowed to call the API with credentials (comma-separated). Empty = same-origin only.
COMPANYBRAIN_CORS_ORIGINS=
COMPANYBRAIN_LOG_LEVEL=info
# Optional: pin secrets instead of the generated files (useful for multiple instances).
# Recommended in production: set these from your host's secret store, then back up with
# `companybrain backup --without-keys` (the generated secret.key decrypts stored secrets).
# COMPANYBRAIN_SECRET=          # 64 hex chars — encrypts secrets at rest (AES-256-GCM)
# COMPANYBRAIN_SIGNING_SECRET=  # signs OAuth client ids / codes

# ─── AI (optional) — smarter task extraction from messages + natural spoken briefings ──
# Anthropic preferred when both are set. Any OpenAI-compatible endpoint works (OpenRouter, Groq, Ollama…).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=gpt-4o-mini

# ─── Voice for the daily briefing (optional) ─────────────────────────────────
# Without this, the browser's built-in voice speaks the briefing (free).
# TTS_PROVIDER=openai           # or: elevenlabs
# OPENAI_TTS_VOICE=coral
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ─── WhatsApp → tasks ────────────────────────────────────────────────────────
# Option A — official Cloud API (Meta). Webhook URL: https://<your-host>/webhooks/whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Option B — scan a QR code with a WhatsApp number (unofficial WhatsApp Web protocol; use a
# dedicated number). Pair in Settings → Integrations.
# WHATSAPP_QR=on

# ─── Email → tasks ───────────────────────────────────────────────────────────
# Intake: a dedicated mailbox (e.g. tasks@yourcompany.com) polled over IMAP.
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
# EMAIL_IMAP_PORT=993
# EMAIL_POLL_SECONDS=60
# Outbound (reminders, digests, confirmations):
EMAIL_SMTP_HOST=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# EMAIL_SMTP_PORT=587
# EMAIL_FROM=Company Brain <tasks@yourcompany.com>
# Alternative intake: inbound-email webhook (Postmark / SendGrid JSON / Mailgun / Cloudflare Email
# Workers) → POST https://<your-host>/webhooks/email with header X-CB-Webhook-Secret (preferred;
# ?secret= also works for providers that can't set headers, and is redacted from logs).
EMAIL_WEBHOOK_SECRET=
# Anti-spoofing: email only counts as "from" a team member when the receiving mail system verified
# the sender (DMARC/DKIM/SPF, see packages/integrations/ENV.md). Recommended: the authserv-id your
# provider stamps on Authentication-Results, e.g. mx.google.com (Gmail) / mx.microsoft.com (M365).
# EMAIL_AUTHSERV_ID=
# UNSAFE: treat every email sender as verified (anyone could email in as any team member).
# EMAIL_TRUST_UNVERIFIED_SENDERS=false

# ─── Web Push (optional) — generated automatically on first boot if unset ────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourcompany.com

# ─── MCP over stdio (Claude Desktop / Cursor offline mode) ───────────────────
# Only for `companybrain mcp`. Prefer the remote URL: Settings → Connect AI.
COMPANYBRAIN_MCP_KEY=
